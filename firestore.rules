
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ======================
    // AUTH & PROFILE HELPERS
    // ======================

    function signedIn() {
      return request.auth != null;
    }

    function hasProfile() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function userTenant() {
      let profile = userProfile();
      return profile != null ? profile.tenantId : "NONE";
    }

    function userRole() {
      let profile = userProfile();
      return profile != null ? profile.role : "GUEST";
    }

    // ======================
    // ROLE DEFINITIONS
    // ======================
    
    function isSuperAdmin() { return signedIn() && userRole() == "super_admin"; }
    function isOwner() { return signedIn() && userRole() == "school_owner"; }
    function isAdmin() { return signedIn() && userRole() == "administrator"; }
    function isAccountant() { return signedIn() && userRole() == "accountant"; }
    function isTeacher() { return signedIn() && userRole() == "teacher"; }
    function isParent() { return signedIn() && userRole() == "parent"; }
    function isStudent() { return signedIn() && userRole() == "student"; }
    
    // ======================
    // TENANT ISOLATION LOGIC
    // ======================

    function belongsToUserTenant(data) {
      let tenant = userTenant();
      return signedIn() && (
        (data.tenantId != null && data.tenantId == tenant) || 
        (data.institutionId != null && data.institutionId == tenant)
      );
    }

    // ======================
    // COLLECTION RULES
    // ======================

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isSuperAdmin() || (hasProfile() && resource.data.tenantId == userTenant()));
      allow create: if true;
      allow update: if signedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow delete: if isSuperAdmin();
    }

    match /institutions/{instId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isSuperAdmin() || (signedIn() && instId == userTenant() && isOwner());
    }

    match /students/{studentId} {
      allow read: if signedIn() && (isSuperAdmin() || belongsToUserTenant(resource.data));
      allow create, update: if signedIn() && (isSuperAdmin() || ((isOwner() || isAdmin() || isTeacher()) && belongsToUserTenant(request.resource.data || resource.data)));
      allow delete: if signedIn() && (isSuperAdmin() || ((isOwner() || isAdmin()) && belongsToUserTenant(resource.data)));
    }

    match /staff/{staffId} {
      allow read: if signedIn() && (isSuperAdmin() || belongsToUserTenant(resource.data));
      allow create, update: if signedIn() && (isSuperAdmin() || ((isOwner() || isAdmin()) && belongsToUserTenant(request.resource.data || resource.data)));
      allow delete: if signedIn() && (isSuperAdmin() || ((isOwner() || isAdmin()) && belongsToUserTenant(resource.data)));
    }

    match /parents/{parentId} {
      allow read: if signedIn() && (isSuperAdmin() || belongsToUserTenant(resource.data));
      allow create, update: if signedIn() && (isSuperAdmin() || ((isOwner() || isAdmin() || isAccountant()) && belongsToUserTenant(request.resource.data || resource.data)));
      allow delete: if signedIn() && (isSuperAdmin() || ((isOwner() || isAdmin()) && belongsToUserTenant(resource.data)));
    }

    match /admissions/{id} {
      allow read: if signedIn() && (isSuperAdmin() || belongsToUserTenant(resource.data));
      allow create: if signedIn();
      allow update: if signedIn() && (isSuperAdmin() || ((isOwner() || isAdmin()) && belongsToUserTenant(request.resource.data || resource.data)));
      allow delete: if signedIn() && (isSuperAdmin() || ((isOwner() || isAdmin()) && belongsToUserTenant(resource.data)));
    }

    match /announcements/{id} {
      allow read: if signedIn() && (isSuperAdmin() || belongsToUserTenant(resource.data));
      allow create, update: if signedIn() && (isSuperAdmin() || ((isOwner() || isAdmin()) && belongsToUserTenant(request.resource.data || resource.data)));
      allow delete: if signedIn() && (isSuperAdmin() || ((isOwner() || isAdmin()) && belongsToUserTenant(resource.data)));
    }

    match /notifications/{id} {
      allow read: if signedIn() && (isSuperAdmin() || belongsToUserTenant(resource.data));
      allow create: if signedIn() && (isSuperAdmin() || ((isOwner() || isAdmin() || isAccountant() || isTeacher()) && belongsToUserTenant(request.resource.data)));
      allow update, delete: if signedIn() && (isSuperAdmin() || belongsToUserTenant(resource.data));
    }

    match /invoices/{id} {
      allow read: if signedIn() && (isSuperAdmin() || belongsToUserTenant(resource.data));
      allow create, update, delete: if signedIn() && (isSuperAdmin() || ((isOwner() || isAdmin() || isAccountant()) && (belongsToUserTenant(request.resource.data || resource.data))));
    }

    match /transactions/{id} {
      allow read: if signedIn() && (isSuperAdmin() || belongsToUserTenant(resource.data));
      allow create, update, delete: if signedIn() && (isSuperAdmin() || ((isOwner() || isAdmin() || isAccountant()) && (belongsToUserTenant(request.resource.data || resource.data))));
    }

    match /student_ledger/{id} {
      allow read: if signedIn() && (isSuperAdmin() || belongsToUserTenant(resource.data));
      allow create, update, delete: if signedIn() && (isSuperAdmin() || ((isOwner() || isAdmin() || isAccountant()) && (belongsToUserTenant(request.resource.data || resource.data))));
    }

    match /counters/{counterId} {
      allow read, write: if signedIn();
    }

    // Global Tenant Rule for other modules (Classes, Subjects, Sections, Logistics)
    match /{collectionName}/{docId} {
      allow read: if signedIn() && (isSuperAdmin() || belongsToUserTenant(resource.data));
      allow create, update: if signedIn() && (isSuperAdmin() || belongsToUserTenant(request.resource.data || resource.data));
      allow delete: if signedIn() && (isSuperAdmin() || (belongsToUserTenant(resource.data) && (isOwner() || isAdmin() || isAccountant())));
    }
  }
}
