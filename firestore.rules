
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ======================
    // AUTH & PROFILE HELPERS
    // ======================

    function signedIn() {
      return request.auth != null;
    }

    function hasProfile() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function userTenant() {
      return hasProfile() ? userProfile().tenantId : "NONE";
    }

    function userRole() {
      return hasProfile() ? userProfile().role : "GUEST";
    }

    function staffId() {
      return hasProfile() ? userProfile().staffId : "NONE";
    }

    // ======================
    // ROLE DEFINITIONS
    // ======================
    
    function isSuperAdmin() { return signedIn() && userRole() == "super_admin"; }
    function isOwner() { return signedIn() && userRole() == "school_owner"; }
    function isAdmin() { return signedIn() && userRole() == "administrator"; }
    function isAccountant() { return signedIn() && userRole() == "accountant"; }
    function isTeacher() { return signedIn() && userRole() == "teacher"; }
    function isParent() { return signedIn() && userRole() == "parent"; }
    function isStudent() { return signedIn() && userRole() == "student"; }
    
    // ======================
    // TENANT ISOLATION LOGIC
    // ======================

    function belongsToUserTenant(data) {
      return signedIn() && (
        data.tenantId == userTenant() || 
        data.institutionId == userTenant()
      );
    }

    // ======================
    // COLLECTION RULES
    // ======================

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isSuperAdmin() || (hasProfile() && resource.data.tenantId == userTenant()));
      allow create: if true;
      allow update: if signedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow delete: if isSuperAdmin();
    }

    match /institutions/{instId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isSuperAdmin() || (signedIn() && instId == userTenant() && isOwner());
    }

    match /notifications/{notifId} {
      allow list: if signedIn() && (isSuperAdmin() || (hasProfile() && (resource.data.tenantId == userTenant() || resource.data.targetStudentId == request.auth.uid)));
      allow get: if signedIn() && (isSuperAdmin() || belongsToUserTenant(resource.data));
      allow create: if signedIn();
      allow update, delete: if signedIn() && (isSuperAdmin() || isOwner() || isAdmin());
    }

    // Identity Registry Rules
    match /parents/{parentId} {
      allow list, get: if true;
      allow create, update: if signedIn() && (isSuperAdmin() || isOwner() || isAdmin());
      allow delete: if isSuperAdmin();
    }

    match /staff/{staffId} {
      allow list, get: if true;
      allow create, update: if signedIn() && (isSuperAdmin() || isOwner() || isAdmin());
      allow delete: if isSuperAdmin();
    }

    match /students/{studentId} {
      allow list, get: if true;
      allow create, update: if signedIn() && (isSuperAdmin() || isOwner() || isAdmin() || isTeacher());
      allow delete: if isSuperAdmin();
    }

    match /student_parents/{relId} {
      allow list, get: if true;
      allow write: if signedIn();
    }

    // Performance & Attendance - Teacher Restrictions
    match /exam_records/{id} {
      allow read, write: if signedIn() && (isSuperAdmin() || isOwner() || isAdmin() || (isTeacher() && belongsToUserTenant(request.resource.data || resource.data)));
    }

    match /attendance/{id} {
      allow read, write: if signedIn() && (isSuperAdmin() || isOwner() || isAdmin() || (isTeacher() && belongsToUserTenant(request.resource.data || resource.data)));
    }

    match /timetables/{id} {
      allow read: if signedIn() && (isSuperAdmin() || belongsToUserTenant(resource.data));
      allow write: if signedIn() && (isSuperAdmin() || isOwner() || isAdmin());
    }

    match /teacher_assignments/{id} {
      allow read: if signedIn() && (isSuperAdmin() || isOwner() || isAdmin() || (isTeacher() && resource.data.teacherId == staffId()));
      allow write: if signedIn() && (isSuperAdmin() || isOwner() || isAdmin());
    }

    // ID Counters
    match /counters/{counterId} {
      allow read, write: if signedIn();
    }

    // Global Tenant Rule for other modules
    match /{collectionName}/{docId} {
      allow read: if signedIn() && (isSuperAdmin() || belongsToUserTenant(resource.data));
      allow create, update: if signedIn() && (isSuperAdmin() || belongsToUserTenant(request.resource.data));
      allow delete: if signedIn() && isSuperAdmin();
    }
  }
}
