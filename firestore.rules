
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // AUTH & PROFILE HELPERS
    // ============================================================

    function signedIn() {
      return request.auth != null;
    }

    function userExists() {
      return signedIn() &&
        exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        );
    }

    function userDoc() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data;
    }

    function userTenant() {
      return signedIn() && userExists()
        ? (
            userDoc().tenantId != null
              ? userDoc().tenantId
              : userDoc().institutionId != null
                ? userDoc().institutionId
                : "NONE"
          )
        : "NONE";
    }

    function userRole() {
      return signedIn() && userExists()
        ? userDoc().role
        : "GUEST";
    }


    // ============================================================
    // ROLE DEFINITIONS
    // ============================================================

    function isSuperAdmin() {
      return signedIn() && userRole() == "super_admin";
    }

    function isAdmin() {
      return signedIn() &&
        (
          userRole() == "school_owner" ||
          userRole() == "administrator"
        );
    }

    function isOwner() {
      return signedIn() && userRole() == "school_owner";
    }

    function isParent() {
      return signedIn() && userRole() == "parent";
    }

    function isParentOf(data) {
      return isParent() &&
        data.parentId != null &&
        data.parentId == userDoc().parentId &&
        data.tenantId == userTenant();
    }


    // ============================================================
    // TENANT ISOLATION
    // ============================================================

    function belongsToUserTenant(data) {
      return signedIn() &&
        (
          isSuperAdmin() ||
          (
            data.tenantId != null &&
            data.tenantId == userTenant()
          ) ||
          (
            data.institutionId != null &&
            data.institutionId == userTenant()
          )
        );
    }


    // ============================================================
    // USERS
    // ============================================================

    match /users/{userId} {

      allow read: if signedIn();

      allow create: if signedIn();

      allow update:
        if signedIn() &&
        (
          request.auth.uid == userId ||
          isSuperAdmin()
        );

      allow delete:
        if isSuperAdmin();
    }


    // ============================================================
    // INSTITUTIONS
    // ============================================================

    match /institutions/{instId} {

      allow read: if true;

      allow create: if true;

      allow update:
        if isSuperAdmin() ||
        (
          signedIn() &&
          instId == userTenant() &&
          (
            isOwner() ||
            isAdmin()
          )
        );

      allow delete:
        if isSuperAdmin();
    }


    // ============================================================
    // STUDENTS
    // ============================================================

    match /students/{studentId} {

      // Collection queries
      allow list:
        if signedIn() &&
        (
          isSuperAdmin() ||
          belongsToUserTenant(resource.data) ||
          (
            userRole() == "student" &&
            resource.data.authUid == request.auth.uid
          )
        );

      // Individual document access
      allow get:
        if signedIn() &&
        (
          isSuperAdmin() ||
          belongsToUserTenant(resource.data) ||
          (
            userRole() == "student" &&
            resource.data.authUid == request.auth.uid
          )
        );

      // Enrollment
      allow create:
        if signedIn() &&
        (
          isSuperAdmin() ||
          isAdmin() ||
          userRole() == "teacher"
        );

      // Updates
      allow update:
        if signedIn() &&
        (
          isSuperAdmin() ||
          isAdmin() ||
          userRole() == "teacher"
        );

      // Delete
      allow delete:
        if signedIn() &&
        (
          isSuperAdmin() ||
          (
            belongsToUserTenant(resource.data) &&
            isAdmin()
          )
        );
    }


    // ============================================================
    // STAFF
    // ============================================================

    match /staff/{staffId} {

      allow list:
        if signedIn() &&
        (
          isSuperAdmin() ||
          belongsToUserTenant(resource.data)
        );

      allow get:
        if true;

      allow create:
        if signedIn() &&
        (
          isSuperAdmin() ||
          isAdmin()
        );

      allow update:
        if signedIn() &&
        (
          isSuperAdmin() ||
          isAdmin()
        );

      allow delete:
        if signedIn() &&
        (
          isSuperAdmin() ||
          (
            belongsToUserTenant(resource.data) &&
            isAdmin()
          )
        );
    }


    // ============================================================
    // PARENTS
    // ============================================================

    match /parents/{parentId} {

      allow list:
        if signedIn() &&
        (
          isSuperAdmin() ||
          belongsToUserTenant(resource.data)
        );

      allow get:
        if true;

      allow create:
        if signedIn() &&
        (
          isSuperAdmin() ||
          isAdmin() ||
          userRole() == "accountant"
        );

      allow update:
        if signedIn() &&
        (
          isSuperAdmin() ||
          isAdmin() ||
          userRole() == "accountant"
        );

      allow delete:
        if signedIn() &&
        (
          isSuperAdmin() ||
          (
            belongsToUserTenant(resource.data) &&
            isAdmin()
          )
        );
    }


    // ============================================================
    // STUDENT / PARENT RELATIONSHIPS
    // ============================================================

    match /student_parents/{relId} {

      allow read:
        if signedIn() &&
        (
          isSuperAdmin() ||
          belongsToUserTenant(resource.data)
        );

      allow create:
        if signedIn() &&
        (
          isSuperAdmin() ||
          isAdmin() ||
          isOwner()
        );

      allow update:
        if signedIn() &&
        (
          isSuperAdmin() ||
          isAdmin() ||
          isOwner()
        );

      allow delete:
        if signedIn() &&
        (
          isSuperAdmin() ||
          isAdmin() ||
          isOwner()
        );
    }


    // ============================================================
    // INVOICES
    // ============================================================

    match /invoices/{id} {

      allow read:
        if signedIn() &&
        (
          isSuperAdmin() ||
          belongsToUserTenant(resource.data) ||
          isParentOf(resource.data)
        );

      allow create, update, delete:
        if signedIn() &&
        (
          isSuperAdmin() ||
          isAdmin() ||
          userRole() == "accountant"
        );
    }


    // ============================================================
    // TRANSACTIONS
    // ============================================================

    match /transactions/{id} {

      allow read:
        if signedIn() &&
        (
          isSuperAdmin() ||
          belongsToUserTenant(resource.data) ||
          isParentOf(resource.data)
        );

      allow create, update, delete:
        if signedIn() &&
        (
          isSuperAdmin() ||
          isAdmin() ||
          userRole() == "accountant"
        );
    }


    // ============================================================
    // STUDENT LEDGER
    // ============================================================

    match /student_ledger/{id} {

      allow read:
        if signedIn() &&
        (
          isSuperAdmin() ||
          belongsToUserTenant(resource.data) ||
          isParentOf(resource.data)
        );

      allow create, update, delete:
        if signedIn() &&
        (
          isSuperAdmin() ||
          isAdmin() ||
          userRole() == "accountant"
        );
    }


    // ============================================================
    // ATTENDANCE
    // ============================================================

    match /attendance/{id} {

      allow read:
        if signedIn() &&
        (
          isSuperAdmin() ||
          belongsToUserTenant(resource.data) ||
          isParentOf(resource.data)
        );

      allow create, update:
        if signedIn() &&
        (
          isSuperAdmin() ||
          isAdmin() ||
          userRole() == "teacher"
        );

      allow delete:
        if signedIn() &&
        (
          isSuperAdmin() ||
          isAdmin()
        );
    }


    // ============================================================
    // EXAM RECORDS
    // ============================================================

    match /exam_records/{id} {

      allow read:
        if signedIn() &&
        (
          isSuperAdmin() ||
          belongsToUserTenant(resource.data) ||
          isParentOf(resource.data)
        );

      allow create, update:
        if signedIn() &&
        (
          isSuperAdmin() ||
          isAdmin() ||
          userRole() == "teacher"
        );

      allow delete:
        if signedIn() &&
        (
          isSuperAdmin() ||
          isAdmin()
        );
    }


    // ============================================================
    // COUNTERS
    // ============================================================

    match /counters/{counterId} {

      allow read, write:
        if signedIn();
    }


    // ============================================================
    // ADMISSIONS
    // ============================================================

    match /admissions/{id} {

      allow read:
        if signedIn() &&
        (
          isSuperAdmin() ||
          belongsToUserTenant(resource.data)
        );

      allow create:
        if signedIn() &&
        (
          isSuperAdmin() ||
          belongsToUserTenant(request.resource.data)
        );

      allow update:
        if signedIn() &&
        (
          isSuperAdmin() ||
          belongsToUserTenant(request.resource.data)
        );

      allow delete:
        if signedIn() &&
        (
          isSuperAdmin() ||
          isAdmin()
        );
    }


    // ============================================================
    // GLOBAL TENANT RULE
    // ============================================================

    match /{collectionName}/{docId} {

      allow read:
        if signedIn() &&
        (
          isSuperAdmin() ||
          belongsToUserTenant(resource.data)
        );

      allow create:
        if signedIn() &&
        (
          isSuperAdmin() ||
          belongsToUserTenant(request.resource.data)
        );

      allow update:
        if signedIn() &&
        (
          isSuperAdmin() ||
          belongsToUserTenant(request.resource.data)
        );

      allow delete:
        if signedIn() &&
        (
          isSuperAdmin() ||
          (
            belongsToUserTenant(resource.data) &&
            isAdmin()
          )
        );
    }
  }
}
