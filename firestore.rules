
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ======================
    // AUTH & PROFILE HELPERS
    // ======================

    function signedIn() {
      return request.auth != null;
    }

    function userProfile() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(path) ? get(path).data : null;
    }

    function userTenant() {
      let profile = userProfile();
      return profile != null ? profile.tenantId : "NONE";
    }

    function userRole() {
      let profile = userProfile();
      return profile != null ? profile.role : "GUEST";
    }

    // ======================
    // ROLE DEFINITIONS
    // ======================
    
    function isSuperAdmin() { return signedIn() && userRole() == "super_admin"; }
    function isOwner() { return signedIn() && (userRole() == "school_owner" || userRole() == "administrator"); }
    function isAdmin() { return signedIn() && (userRole() == "school_owner" || userRole() == "administrator"); }
    function isAccountant() { return signedIn() && userRole() == "accountant"; }
    function isTeacher() { return signedIn() && userRole() == "teacher"; }
    
    // ======================
    // TENANT ISOLATION LOGIC
    // ======================

    function belongsToUserTenant(data) {
      let tenant = userTenant();
      // Allow access if tenant matches, or if it's super admin
      return signedIn() && (
        isSuperAdmin() || 
        (data.tenantId != null && data.tenantId == tenant) || 
        (data.institutionId != null && data.institutionId == tenant)
      );
    }

    // ======================
    // COLLECTION RULES
    // ======================

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isSuperAdmin() || (userTenant() != "NONE" && resource.data.tenantId == userTenant()));
      allow create: if true;
      allow update: if signedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow delete: if isSuperAdmin();
    }

    match /institutions/{instId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isSuperAdmin() || (signedIn() && instId == userTenant() && isOwner());
    }

    match /students/{studentId} {
      allow read: if signedIn() && (isSuperAdmin() || belongsToUserTenant(resource.data));
      allow create, update: if signedIn() && (isSuperAdmin() || isAdmin() || isTeacher());
      allow delete: if signedIn() && (isSuperAdmin() || isAdmin());
    }

    match /staff/{staffId} {
      allow read: if signedIn() && (isSuperAdmin() || belongsToUserTenant(resource.data));
      allow create, update: if signedIn() && (isSuperAdmin() || isAdmin());
      allow delete: if signedIn() && (isSuperAdmin() || isAdmin());
    }

    match /parents/{parentId} {
      allow read: if signedIn() && (isSuperAdmin() || belongsToUserTenant(resource.data));
      allow create, update: if signedIn() && (isSuperAdmin() || isAdmin() || isAccountant());
      allow delete: if signedIn() && (isSuperAdmin() || isAdmin());
    }

    match /invoices/{id} {
      allow read: if signedIn() && (isSuperAdmin() || belongsToUserTenant(resource.data));
      allow create, update, delete: if signedIn() && (isSuperAdmin() || isAdmin() || isAccountant());
    }

    match /transactions/{id} {
      allow read: if signedIn() && (isSuperAdmin() || belongsToUserTenant(resource.data));
      allow create, update, delete: if signedIn() && (isSuperAdmin() || isAdmin() || isAccountant());
    }

    match /student_ledger/{id} {
      allow read: if signedIn() && (isSuperAdmin() || belongsToUserTenant(resource.data));
      allow create, update, delete: if signedIn() && (isSuperAdmin() || isAdmin() || isAccountant());
    }

    match /attendance/{id} {
      allow read: if signedIn() && (isSuperAdmin() || belongsToUserTenant(resource.data));
      allow create, update: if signedIn() && (isSuperAdmin() || isAdmin() || isTeacher());
      allow delete: if signedIn() && (isSuperAdmin() || isAdmin());
    }

    match /counters/{counterId} {
      allow read, write: if signedIn();
    }

    // Global Tenant Rule for other modules (Classes, Subjects, Sections, Logistics)
    match /{collectionName}/{docId} {
      allow read: if signedIn() && (isSuperAdmin() || belongsToUserTenant(resource.data));
      allow create, update: if signedIn() && (isSuperAdmin() || belongsToUserTenant(request.resource.data || resource.data));
      allow delete: if signedIn() && (isSuperAdmin() || (belongsToUserTenant(resource.data) && isAdmin()));
    }
  }
}
