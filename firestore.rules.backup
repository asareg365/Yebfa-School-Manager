
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ======================
    // AUTH & PROFILE HELPERS
    // ======================

    function signedIn() {
      return request.auth != null;
    }

    // Direct lookup of the user document
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function userExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userTenant() {
      return signedIn() && userExists() ? userDoc().tenantId : "NONE";
    }

    function userRole() {
      return signedIn() && userExists() ? userDoc().role : "GUEST";
    }

    // ======================
    // ROLE DEFINITIONS
    // ======================
    
    function isSuperAdmin() { return signedIn() && userRole() == "super_admin"; }
    function isAdmin() { return signedIn() && (userRole() == "school_owner" || userRole() == "administrator"); }
    function isOwner() { return signedIn() && userRole() == "school_owner"; }
    
    // ======================
    // TENANT ISOLATION LOGIC
    // ======================

    function userTenant() {
  return signedIn() && userExists()
    ? (
        userDoc().tenantId != null
          ? userDoc().tenantId
          : userDoc().institutionId != null
            ? userDoc().institutionId
            : "NONE"
      )
    : "NONE";
}

    // ======================
    // COLLECTION RULES
    // ======================

    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth.uid == userId || isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    match /institutions/{instId} {
      allow read: if true;
      allow create: if true;
      allow update: if isSuperAdmin() || (signedIn() && instId == userTenant() && (isOwner() || isAdmin()));
      allow delete: if isSuperAdmin();
    }

    match /students/{studentId} {
      // Allow limited list for login/identity verification
      allow list: if (request.query.limit <= 5) || (signedIn() && belongsToUserTenant(resource.data));
      allow get: if true;
      allow create, update: if signedIn() && (isSuperAdmin() || isAdmin() || userRole() == "teacher");
      allow delete: if signedIn() && (isSuperAdmin() || belongsToUserTenant(resource.data) && isAdmin());
    }

    match /staff/{staffId} {
      allow list: if (request.query.limit <= 5) || (signedIn() && belongsToUserTenant(resource.data));
      allow get: if true;
      allow create, update: if signedIn() && (isSuperAdmin() || isAdmin());
      allow delete: if signedIn() && (isSuperAdmin() || belongsToUserTenant(resource.data) && isAdmin());
    }
match /students/{studentId} {

  allow read: if signedIn() &&
    (
      isSuperAdmin() ||
      belongsToUserTenant(resource.data)
    );

  allow create, update: if signedIn() &&
    (
      isSuperAdmin() ||
      isAdmin() ||
      userRole() == "teacher"
    );

  allow delete: if signedIn() &&
    (
      isSuperAdmin() ||
      (belongsToUserTenant(resource.data) && isAdmin())
    );
}
    match /parents/{parentId} {
      allow list: if (request.query.limit <= 5) || (signedIn() && belongsToUserTenant(resource.data));
      allow get: if true;
      allow create, update: if signedIn() && (isSuperAdmin() || isAdmin() || userRole() == "accountant");
      allow delete: if signedIn() && (isSuperAdmin() || belongsToUserTenant(resource.data) && isAdmin());
    }

    match /student_parents/{relId} {
      allow read: if (request.query.limit <= 10) || signedIn();
      allow write: if signedIn() && (isAdmin() || isOwner());
    }

    match /invoices/{id} {
      allow read: if signedIn() && (isSuperAdmin() || belongsToUserTenant(resource.data));
      allow create, update, delete: if signedIn() && (isSuperAdmin() || isAdmin() || userRole() == "accountant");
    }

    match /transactions/{id} {
      allow read: if signedIn() && (isSuperAdmin() || belongsToUserTenant(resource.data));
      allow create, update, delete: if signedIn() && (isSuperAdmin() || isAdmin() || userRole() == "accountant");
    }

    match /student_ledger/{id} {
      allow read: if signedIn() && (isSuperAdmin() || belongsToUserTenant(resource.data));
      allow create, update, delete: if signedIn() && (isSuperAdmin() || isAdmin() || userRole() == "accountant");
    }

    match /attendance/{id} {
      allow read: if signedIn() && (isSuperAdmin() || belongsToUserTenant(resource.data));
      allow create, update: if signedIn() && (isSuperAdmin() || isAdmin() || userRole() == "teacher");
      allow delete: if signedIn() && (isSuperAdmin() || isAdmin());
    }

    match /exam_records/{id} {
      allow read: if signedIn() && (isSuperAdmin() || belongsToUserTenant(resource.data));
      allow create, update: if signedIn() && (isSuperAdmin() || isAdmin() || userRole() == "teacher");
      allow delete: if signedIn() && (isSuperAdmin() || isAdmin());
    }

    match /counters/{counterId} {
      allow read, write: if true; 
    }

    match /admissions/{id} {
      allow read: if signedIn() && (isSuperAdmin() || belongsToUserTenant(resource.data));
      allow create, update: if signedIn() && (isSuperAdmin() || belongsToUserTenant(request.resource.data || resource.data));
      allow delete: if signedIn() && (isSuperAdmin() || isAdmin());
    }

    // Global Tenant Rule for other modules
    match /{collectionName}/{docId} {
      allow read: if signedIn() && (isSuperAdmin() || belongsToUserTenant(resource.data));
      allow create, update: if signedIn() && (isSuperAdmin() || belongsToUserTenant(request.resource.data || resource.data));
      allow delete: if signedIn() && (isSuperAdmin() || (belongsToUserTenant(resource.data) && isAdmin()));
    }
  }
}


